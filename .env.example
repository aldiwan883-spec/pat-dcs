# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://patdcs.com

# Contact form delivery (https://resend.com). Without RESEND_API_KEY the form
# answers 503 and the page falls back to showing the direct e-mail address.
RESEND_API_KEY=
CONTACT_TO=info@patdcs.com
CONTACT_FROM="PAT Website <no-reply@patdcs.com>"
